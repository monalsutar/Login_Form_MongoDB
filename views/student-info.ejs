<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Information</title>
    <style>
        /* Your existing CSS */
    </style>
</head>
<body>
    <div class="container">
        <!-- Display student data -->
        <img src="<%= User.url %>" alt="Student Image">
        <h1>Student Information</h1>
        <div class="info-section">
            <div class="info-block"><h2>Name: <%= User.name %></h2></div>
            <div class="info-block"><h2>PRN: <%= User.prn %></h2></div>
            <div class="info-block"><h2>Mobile No.: <%= User.mobile %></h2></div>
            <div class="info-block"><h2>Age: <%= User.age %></h2></div>
            <div class="info-block"><h2>Address: <%= User.address %></h2></div>
            <div class="info-block"><h2>Email: <%= User.email %></h2></div>
        </div>
    </div>
</body>
</html>
