<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login Form</title>

    <style>
        * {
            box-sizing: border-box;
        }

        /* Blue Gradient Background */
        body {
            font-family: 'Arial', sans-serif;
            margin: 0;
            height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            background: linear-gradient(135deg, #1e3c72, #2a5298, #6dd5ed, #2193b0);
            background-size: cover;
        }

        form {
            background-color: rgba(255, 255, 255, 0.9);
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 8px 16px rgba(0, 0, 0, 0.2);
            width: 100%;
            max-width: 500px;
            animation: formAppear 1s ease-out;
        }

        @keyframes formAppear {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        h2 {
            text-align: center;
            color: #333;
            font-size: 28px;
            margin-bottom: 20px;
        }

        .form-group {
            width: 100%;
            display: flex;
            flex-direction: column;
            margin-bottom: 20px;
        }

        label {
            color: #333;
            font-weight: bold;
            margin-bottom: 5px;
        }

        input[type="email"],
        input[type="number"] {
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 5px;
            font-size: 16px;
            color: #333;
            transition: all 0.3s ease;
            background-color: #f9f9f9;
        }

        input[type="email"]:focus,
        input[type="number"]:focus {
            border-color: #2a5298;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            outline: none;
            background-color: #fff;
        }

        input[type="submit"],
        button {
            width: 100%;
            padding: 15px;
            background-color: #2193b0;
            border: none;
            color: #fff;
            font-size: 18px;
            font-weight: bold;
            text-transform: uppercase;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease, transform 0.2s ease;
            margin-top: 10px;
        }

        input[type="submit"]:hover,
        button:hover {
            background-color: #1e3c72;
            transform: translateY(-3px);
        }

        .full-width {
            width: 100%;
        }

        /* For mobile responsiveness */
        @media (max-width: 768px) {
            form {
                padding: 20px;
            }

            h2 {
                font-size: 22px;
            }
        }

        /* Additional styles for account links */
        .account-text {
            text-align: center;
            font-size: 14px;
            color: #333;
            margin-top: 10px;
            font-weight: bold;
        }

        .login-link, .signup-link {
            color: #2193b0; /* Blue color for links */
            cursor: pointer;
            font-weight: bold;
            text-decoration: underline;
        }

        .login-link:hover, .signup-link:hover {
            color: #1e3c72; /* Darker blue on hover */
        }
    </style>
</head>
<body>

    <form action="/fetch" method="post">
        <h2>Login</h2>
    
        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" name="email" placeholder="Enter your email" required autocomplete="off">
        </div>
    
        <div class="form-group">
            <label for="prn">PRN</label>
            <input type="number" id="prn" name="prn" placeholder="Enter your PRN" required autocomplete="off">
        </div>
    
        <div class="button-container">
            <input type="submit" value="Submit">
        </div>

        <!-- Links for existing and new accounts -->
        <div class="account-text">
            Don't Have Account? <span class="signup-link" onclick="window.location.href='/'">SignUp here</span>
        </div>
    </form>

</body>
</html>
